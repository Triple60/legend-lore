# Copy to .env and fill in from Supabase (the Connect button, or Project
# Settings → API Keys / Data API).
# Both values are public by design; security is enforced by row-level security
# policies in supabase/migrations, not by keeping these secret.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy anon key.
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Optional: "true" to offer email-code login (requires SMTP in Supabase).
PUBLIC_EMAIL_LOGIN=
